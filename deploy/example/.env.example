# Copiar a .env (junto a compose.yml), ajustar y ejecutar ./init.sh antes del primer `up`.

# OpenBao como proveedor de secretos y CA SSH (recomendado). Para usar solo el proveedor local
# cifrado, borra esta línea (y OPENBAO_ROLE_ID y VAULT_OPENBAO_ROLE_ID).
COMPOSE_FILE=compose.yml:compose.openbao.yml
# Los rellena init.sh: la AppRole de la app (API y worker) y la de la caja fuerte de
# credenciales (solo la API; el worker no puede leerla).
OPENBAO_ROLE_ID=
VAULT_OPENBAO_ROLE_ID=
# AppRole de la terminal (solo la API): la escribe init.sh.
TERMINAL_OPENBAO_ROLE_ID=

# Registro de las imágenes, sin barra final. Imágenes: <registro>/{web,api,worker}. Las
# publicadas están en GitHub Container Registry; cambia el valor si usas tus propias imágenes.
INFRAWARD_REGISTRY=ghcr.io/infraward
# Versión publicada (tag vX.Y.Z) o latest.
INFRAWARD_VERSION=latest

# URL con la que navegadores y servidores llegan a la web (sin barra final). Fuera de localhost,
# pon delante un proxy con HTTPS: la cookie de sesión es Secure.
INFRAWARD_PUBLIC_URL=http://localhost:8080
INFRAWARD_HTTP_PORT=8080

# Administrador inicial (solo se crea si no existe ningún usuario).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

POSTGRES_DB=infraward
POSTGRES_USER=infraward
POSTGRES_PASSWORD=

# Réplicas del worker (DESIGN §20): se reparten los jobs sin duplicarlos. También con
# `docker compose up -d --scale worker=3`. Todas comparten ./data/worker (caché de Trivy).
WORKER_REPLICAS=1
# Jobs a la vez contra un mismo servidor (un CT cuenta contra su nodo), entre todas las réplicas.
# HOST_MAX_JOBS=2
# HOST_MAX_SCAN_JOBS=1

# Terminal (gateway, DESIGN §11): el navegador llega por la web en /gateway/ (sin puerto propio).
# Sesiones a la vez por servidor y por persona.
# HOST_MAX_TERMINAL_SESSIONS=4
# TERMINAL_MAX_SESSIONS_PER_USER=3
