# Copiar a deploy/.env (ignorado por git) y ajustar.
POSTGRES_DB=infraward
POSTGRES_USER=infraward
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
# OpenBao (proveedor de secretos opcional). Descomenta para que infra:up también lo levante.
# COMPOSE_PROFILES=openbao   (o openbao,oidc para el Keycloak de pruebas)
OPENBAO_PORT=8200
# Keycloak de pruebas para el login con OIDC (perfil oidc). Lo levanta y prepara:
#   pnpm keycloak:bootstrap
KEYCLOAK_PORT=8081
