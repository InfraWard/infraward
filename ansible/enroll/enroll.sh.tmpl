  pve-cluster-status) arity 0 0 && run pvesh get /cluster/status --output-format json ;;
  pve-cluster-resources) arity 0 0 && run pvesh get /cluster/resources --type vm --output-format json ;;
  pve-guest-config)
    arity 3 3
    check 1 '^(lxc|qemu)$' "$1"
    check 2 "$NODE" "$2"
    check 3 "$VMID" "$3"
    guest "$2" "$1" "$3"
    run pvesh get "/nodes/$2/$1/$3/config" --output-format json
    ;;
  pve-lxc-interfaces)
    arity 2 2
    check 1 "$NODE" "$1"
    check 2 "$VMID" "$2"
    guest "$1" lxc "$2"
    run pvesh get "/nodes/$1/lxc/$2/interfaces" --output-format json
    ;;
  pct-exec)
    # Root dentro de un CT de este nodo (recolección con Ansible): se valida el vmid, no el comando.
    [ "$nargs" -ge 2 ] || reject "$query: número de argumentos no válido"
    check 1 "$VMID" "$1"
    [ -f "$PVE_DIR/lxc/$1.conf" ] || reject "$query: el CT $1 no es de este nodo"
    vmid=$1
    shift
    run pct exec "$vmid" -- "$@"
    ;;
  docker-version) arity 0 0 && run docker info --format '{{.ServerVersion}}' ;;
  docker-ps) arity 0 0 && run docker ps -a -q --no-trunc ;;
  docker-inspect-containers) each "$CONTAINER_ID" "$@" && run docker inspect --format "$CONTAINER_FORMAT" "$@" ;;
  docker-images) arity 0 0 && run docker images -q --no-trunc ;;
  docker-image-inspect) each "$IMAGE_ID" "$@" && run docker image inspect --format "$IMAGE_FORMAT" "$@" ;;
  docker-volumes) arity 0 0 && run docker volume ls -q ;;
  docker-volume-inspect) each "$DOCKER_NAME" "$@" && run docker inspect --type volume --format "$VOLUME_FORMAT" "$@" ;;
  docker-networks) arity 0 0 && run docker network ls --format '{{.Name}}' ;;
  docker-network-inspect) each "$DOCKER_NAME" "$@" && run docker inspect --type network --format "$NETWORK_FORMAT" "$@" ;;
  docker-save)
    # Una imagen por su id, a la salida estándar: nada de `-o <ruta>` (escribiría como root).
    arity 1 1
    check 1 "$IMAGE_ID" "$1"
    run docker save "$1"
    ;;
  # v5: rutas de nginx (y NPM en contenedor), filtradas aquí mismo por el filtro de arriba.
  nginx-routes) arity 0 0 && run sh -c "$NGINX_FILTER" sh nginx -T ;;
  docker-nginx-routes)
    arity 1 1
    check 1 "$CONTAINER_ID" "$1"
    run sh -c "$NGINX_FILTER" sh docker exec "$1" nginx -T
    ;;
  # v6: paquetes de los procesos en marcha, calculados aquí mismo por el script de arriba.
  process-packages) arity 0 0 && run sh -c "$PROCESS_FILTER" sh ;;
  sshd-auth) arity 0 0 && run sh -c "$SSHD_FILTER" sh ;;
  plesk-version) arity 0 0 && run plesk version ;;
  # Consultas FIJAS a `psa` (las de packages/connectors/src/plesk/queries.ts).
  plesk-domains) arity 0 0 && plesk_db "SELECT JSON_OBJECT('id', d.id, 'name', d.name, 'status', d.status, 'htype', d.htype, 'webspace', d.webspace_id, 'parent', d.parentDomainId, 'created', d.cr_date, 'owner', c.login, 'certificate', h.certificate_id) FROM domains d LEFT JOIN clients c ON c.id = d.cl_id LEFT JOIN hosting h ON h.dom_id = d.id ORDER BY d.id" ;;
  plesk-aliases) arity 0 0 && plesk_db "SELECT JSON_OBJECT('id', a.id, 'name', a.name, 'status', a.status, 'domain', a.dom_id) FROM domain_aliases a ORDER BY a.id" ;;
  plesk-databases) arity 0 0 && plesk_db "SELECT JSON_OBJECT('id', b.id, 'name', b.name, 'type', b.type, 'domain', b.dom_id, 'host', s.host, 'port', s.port) FROM data_bases b LEFT JOIN DatabaseServers s ON s.id = b.db_server_id ORDER BY b.id" ;;
  plesk-certificates) arity 0 0 && plesk_db "SELECT JSON_OBJECT('id', c.id, 'name', c.name, 'cert', c.cert, 'domain', d.id) FROM certificates c LEFT JOIN Repository r ON r.component_id = c.id LEFT JOIN domains d ON d.cert_rep_id = r.rep_id ORDER BY c.id" ;;
  *) reject "consulta desconocida" ;;
esac
HELPER
  } >"$tmp"
  chmod 755 "$tmp"
  chown root:root "$tmp"
  mv -f "$tmp" "$QUERY_HELPER"
  # El ayudante de Plesk de la v3 ya no se usa.
  rm -f "$LEGACY_PLESK_HELPER"
}

# Huellas SHA256 de las host keys, una por línea: "<tipo> SHA256:<huella>".
host_keys_text() {
  local f line fp type out=""
  for f in /etc/ssh/ssh_host_*_key.pub; do
    [ -f "$f" ] || continue
    line=$(ssh-keygen -lf "$f") || continue
    fp=$(printf '%s' "$line" | awk '{print $2}')
    type=${line##*(}
    type=${type%)}
    [[ $fp =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]] || continue
    [[ $type =~ ^(ED25519|ECDSA|RSA)$ ]] || continue
    out+="${out:+$'\n'}$type $fp"
  done
  [ -n "$out" ] || die "no se encontraron host keys en /etc/ssh"
  printf '%s' "$out"
}

# Las mismas huellas en JSON, para que InfraWard fije la buena en la primera conexión.
host_keys_json() {
  local text type fp out=""
  text=$(host_keys_text)
  while read -r type fp; do
    out+="${out:+,}{\"type\":\"$type\",\"fingerprint\":\"$fp\"}"
  done <<<"$text"
  printf '%s' "$out"
}

# Avisa (sin cambiar nada) si sshd_config limita los usuarios y deja fuera al de inventario.
warn_sshd_restrictions() {
  local user=$1 config
  config=$(sshd -T -C "user=$user,host=localhost,addr=127.0.0.1" 2>/dev/null) || return 0
  if printf '%s\n' "$config" | grep -qiE '^(allowusers|allowgroups) '; then
    log "AVISO: sshd tiene AllowUsers/AllowGroups; comprueba que '$user' puede entrar"
  fi
  if printf '%s\n' "$config" | grep -qi '^pubkeyauthentication no'; then
    log "AVISO: sshd tiene PubkeyAuthentication no; InfraWard no podrá conectarse"
  fi
}

log() { printf '[infraward] %s\n' "$*" >&2; }
die() {
  log "ERROR: $*"
  exit 1
}

# stdin a /dev/null: con `curl | bash` ningún comando debe leer el resto del script.
main "$@" </dev/null
