#!/usr/bin/env bash
# Script de alta de InfraWard (docs/DESIGN.md §7).
#
# La API lo genera para un único servidor. Dos modos:
#   - online:   curl -fsSL <url>/enroll/<token> | sudo bash
#               Al terminar avisa a la API (POST /enroll/<token>/done) con las huellas de las host keys.
#   - embedded: echo '<script en base64>' | base64 -d | gunzip | sudo bash
#               Para servidores que no llegan a la API (VPN, NAT). No lleva token ni avisa a nadie:
#               imprime las huellas de las host keys para pegarlas en InfraWard.
# Opciones: --install-sudo instala sudo si falta (Proxmox no lo trae); solo si se pide.
#
# Crea el usuario dedicado `inventory`, el ayudante de root `infraward-query` (lista cerrada de
# consultas de SOLO LECTURA, salvo `pct-exec`) y un sudoers que solo permite ese ayudante (nunca
# ALL; vale igual con sudo y con sudo-rs). Dos formas de acceso (DESIGN §6, §7):
#   - static_key:     instala la clave pública del asset en authorized_keys (con `restrict`).
#   - ca_certificate: NO instala ninguna clave. Configura sshd para que `inventory` acepte
#                     certificados de vida corta firmados por la CA SSH de InfraWard
#                     (TrustedUserCAKeys) y solo con el principal `inventory`
#                     (AuthorizedPrincipalsFile). Valida con `sshd -t` antes de recargar y, si
#                     algo falla, deja la configuración como estaba. Después quita la clave
#                     estática de ESTE asset si la tenía (migración desde static_key).
# Acceso interactivo de administración (opcional, solo en modo CA; DESIGN §7): con `operator`
# configura la cuenta `infraward-admin` con sudo, que solo entra con certificados de la CA con
# el principal de rol `infraward-operators` (los emite la API tras MFA para la terminal); con
# `none` lo retira; con `keep` no toca lo que haya. Nunca usa el usuario `inventory`.
# Cada asset solo toca su línea de authorized_keys (comentario inventory@infraward:<asset-id>).
# No contiene secretos: solo claves públicas y, en modo online, el token y la URL de la API.
#
# Idempotente: volver a ejecutarlo actualiza el sudoers y la CA sin duplicar nada. Todo va
# dentro de main(), que se invoca en la última línea: si la descarga se corta, bash no ejecuta
# nada.

main() {
  set -euo pipefail
  umask 077
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export LC_ALL=C
  # Ayudante de root (lo usan install_query_helper y write_sudoers) y el de Plesk de la v3.
  QUERY_HELPER=/usr/local/libexec/infraward/infraward-query
  LEGACY_PLESK_HELPER=/usr/local/libexec/infraward/plesk-query
  # Acceso interactivo de administración (configure_admin_access / remove_admin_access).
  ADMIN_USER=infraward-admin
  ADMIN_PRINCIPAL=infraward-operators
  ADMIN_DROPIN=/etc/ssh/sshd_config.d/01-infraward-admin.conf
  ADMIN_SUDOERS=/etc/sudoers.d/infraward-admin
  ADMIN_PRINCIPALS=/etc/ssh/infraward/principals/infraward-admin
  ADMIN_VERSION_FILE=/etc/infraward/admin-access-version
  ADMIN_CREATED_MARK=/etc/infraward/admin-access-created-user

  local mode='__INFRAWARD_MODE__'
  local api_url='__INFRAWARD_API_URL__'
  local token='__INFRAWARD_TOKEN__'
  local public_key='__INFRAWARD_PUBLIC_KEY__'
  local key_comment='__INFRAWARD_KEY_COMMENT__'
  local version='__INFRAWARD_SUDOERS_VERSION__'
  local auth='__INFRAWARD_AUTH__'
  local ca_keys='__INFRAWARD_CA_KEYS__'
  local ca_version='__INFRAWARD_CA_VERSION__'
  # Cuándo generó la API este script (epoch). En modo CA, un reloj atrasado hace que sshd rechace
  # los certificados («not yet valid»): mejor pararse antes de tocar nada.
  local issued_at='__INFRAWARD_ISSUED_AT__'
  local admin_access='__INFRAWARD_ADMIN_ACCESS__'
  local admin_version='__INFRAWARD_ADMIN_ACCESS_VERSION__'
  local user=inventory
  local sudoers_file=/etc/sudoers.d/infraward-inventory
  local version_file=/etc/infraward/sudoers-version

  local install_sudo=0 arg
  for arg in "$@"; do
    case $arg in
      --install-sudo) install_sudo=1 ;;
      *) die "opción desconocida: '$arg' (solo se admite --install-sudo)" ;;
    esac
  done

  case $auth in
    static_key | ca_certificate) ;;
    *) die "modo de acceso desconocido: '$auth'" ;;
  esac
  case $admin_access in
    keep | none) ;;
    operator) [ "$auth" = ca_certificate ] || die "el acceso de administración requiere el modo CA" ;;
    *) die "acceso de administración desconocido: '$admin_access'" ;;
  esac
  [ "$(id -u)" -eq 0 ] || die "hay que ejecutarlo como root"
  if [ "$auth" = ca_certificate ]; then
    local now
    now=$(date -u +%s)
    if [ "$now" -lt $((issued_at - 300)) ]; then
      die "el reloj del servidor va atrasado ($(date -u '+%F %T') UTC; el comando se generó $(((issued_at - now) / 60)) min después). Los certificados duran minutos y sshd los rechazaría: sincroniza la hora (p. ej. 'chronyc makestep' o 'timedatectl set-ntp true') y vuelve a ejecutar el comando"
    fi
  fi
  if ! command -v sudo >/dev/null || ! command -v visudo >/dev/null; then
    [ "$install_sudo" -eq 1 ] ||
      die "falta 'sudo' (Proxmox no lo trae de serie); instálalo o vuelve a ejecutar el comando con --install-sudo"
    install_sudo_package
  fi
  local cmd required=(ssh-keygen useradd usermod getent install awk)
  [ "$mode" = online ] && required+=(curl)
  for cmd in "${required[@]}"; do
    command -v "$cmd" >/dev/null || die "falta '$cmd'; instálalo y vuelve a ejecutar el comando"
  done
  command -v sshd >/dev/null || die "no hay servidor SSH (sshd) instalado"
  command -v python3 >/dev/null ||
    log "AVISO: falta python3; la verificación funcionará, pero la recolección (Ansible) no hasta que lo instales"

  log "Usuario '$user'"
  if ! id "$user" >/dev/null 2>&1; then
    useradd --system --create-home --home-dir "/home/$user" --shell /bin/sh \
      --comment "InfraWard (inventario de solo lectura)" "$user"
  fi
  [ "$(id -u "$user")" -ne 0 ] || die "el usuario '$user' tiene uid 0; no se toca"
  # '*' y no '!': sin contraseña posible, pero el login con clave sigue funcionando.
  usermod -p '*' "$user"

  local home auth_keys
  home=$(getent passwd "$user" | cut -d: -f6)
  auth_keys="$home/.ssh/authorized_keys"
  if [ "$auth" = static_key ]; then
    log "Clave pública en authorized_keys"
    # ~/.ssh es del usuario de inventario: se crea y se escribe como él, nunca como root.
    check_ssh_paths "$home" "$user"
    # Un usuario adoptado sin home: se crea como root (su padre no lo controla él).
    [ -d "$home" ] || install -d -m 750 -o "$user" -g "$(id -gn "$user")" "$home"
    as_user "$user" mkdir -p -m 700 "$home/.ssh"
    as_user "$user" chmod 700 "$home/.ssh"
    # Sustituye la línea de este asset (si la hay) por la actual: nunca duplica ni toca otras.
    # `restrict`: sin pty, reenvíos ni agente; el inventario no los necesita.
    replace_key_line "$auth_keys" "$key_comment" "restrict $public_key" "$user"
  fi

  install_query_helper
  log "sudoers acotado (versión $version): solo el ayudante $QUERY_HELPER"
  write_sudoers "$user" "$sudoers_file" "$version"
  install -d -m 755 /etc/infraward
  printf '%s\n' "$version" >"$version_file"
  chmod 644 "$version_file"

  if [ "$auth" = ca_certificate ]; then
    log "CA SSH de InfraWard (versión $ca_version): certificados de vida corta, sin claves estáticas"
    configure_ssh_ca "$user" "$ca_keys" "$ca_version"
    # Solo cuando sshd ya acepta los certificados: la clave estática de este asset sobra.
    if [ -e "$auth_keys" ] || [ -L "$auth_keys" ]; then
      check_ssh_paths "$home" "$user"
      replace_key_line "$auth_keys" "$key_comment" "" "$user"
    fi
  fi

  case $admin_access in
    operator)
      log "Acceso interactivo de administración (versión $admin_version): cuenta $ADMIN_USER, solo con certificados de la CA"
      configure_admin_access "$user" "$admin_version"
      ;;
    none) remove_admin_access ;;
  esac

  warn_sshd_restrictions "$user"

  if [ "$mode" = embedded ]; then
    local fingerprints
    fingerprints=$(host_keys_text)
    log "Hecho. Pega en InfraWard las huellas de las host keys para confirmar el alta:"
    printf '\n%s\n%s\n%s\n\n' '----- infraward host keys -----' "$fingerprints" '----- fin -----'
    return 0
  fi

  log "Avisando a InfraWard"
  local hostkeys
  hostkeys=$(host_keys_json)
  curl -fsS -X POST -H 'Content-Type: application/json' \
    --data "{\"hostKeys\":[$hostkeys]}" \
    "$api_url/enroll/$token/done" >/dev/null ||
    die "no se pudo avisar a la API; si el token ha caducado, genera un comando nuevo"

  log "Hecho. InfraWard verificará ahora la conexión por SSH."
}

# Ejecuta un comando como <usuario> (sin su contraseña: el script corre como root). Lo que hay en
# su home lo controla él: escribir ahí como root seguiría un enlace simbólico que él haya puesto
# (p. ej. ~/.ssh -> /root/.ssh) y le daría ficheros de root. Como él, el kernel no le deja.
as_user() {
  local user=$1
  shift
  if command -v runuser >/dev/null 2>&1; then
    (cd / && runuser -u "$user" -- "$@")
  elif command -v setpriv >/dev/null 2>&1; then
    (cd / && setpriv --reuid="$user" --regid="$(id -g "$user")" --init-groups -- "$@")
  else
    # su no pasa argumentos igual en todas partes (util-linux, BusyBox): una sola orden, citada
    # para bash (el script ya exige bash).
    (cd / && su -s "$(command -v bash)" "$user" -c "$(printf '%q ' "$@")")
  fi
}

# Para avisar con claridad (y no solo fallar al escribir como el usuario): ~/.ssh y
# authorized_keys no pueden ser enlaces simbólicos, ni de otro dueño, ni authorized_keys un
# fichero con más de un enlace duro.
check_ssh_paths() {
  local home=$1 user=$2
  local dir="$home/.ssh" file="$home/.ssh/authorized_keys"
  if [ -L "$dir" ]; then
    die "$dir es un enlace simbólico; no se sigue. Revisa ese servidor: puede que alguien haya entrado como '$user'"
  fi
  if [ -e "$dir" ]; then
    [ -d "$dir" ] || die "$dir no es un directorio"
    [ "$(stat -c %u "$dir")" = "$(id -u "$user")" ] || die "$dir no es de '$user'"
  fi
  if [ -L "$file" ]; then
    die "$file es un enlace simbólico; no se sigue. Revisa ese servidor: puede que alguien haya entrado como '$user'"
  fi
  if [ -e "$file" ]; then
    [ -f "$file" ] || die "$file no es un fichero normal"
    [ "$(stat -c %h "$file")" = 1 ] || die "$file tiene varios enlaces duros; no se toca"
    [ "$(stat -c %u "$file")" = "$(id -u "$user")" ] || die "$file no es de '$user'"
  fi
}

# Sustituye en authorized_keys la línea que termina en " <comentario>" por <línea> (vacía =
# solo quitarla). Las demás líneas (otros assets, las del administrador) quedan intactas. Todo
# como <usuario>: fichero temporal en su ~/.ssh (600) y `mv`, que sustituye la entrada sin
# seguir un enlace que aparezca entre medias.
replace_key_line() {
  local file=$1 comment=$2 line=$3 user=$4
  # shellcheck disable=SC2016 # el script es para el sh del usuario: sus $ no se expanden aquí
  as_user "$user" sh -c '
    set -eu
    umask 077
    f=$1 c=" $2" l=$3
    t=$(mktemp "$f.XXXXXX")
    trap '\''rm -f "$t"'\'' EXIT
    if [ -f "$f" ]; then
      awk -v c="$c" '\''length($0) < length(c) || substr($0, length($0) - length(c) + 1) != c'\'' "$f" >"$t"
    fi
    [ -z "$l" ] || printf "%s\n" "$l" >>"$t"
    chmod 600 "$t"
    mv -f "$t" "$f"
    trap - EXIT
  ' sh "$file" "$comment" "$line" || die "no se pudo escribir $file como '$user'"
}

# `sshd -t`. Si falta el directorio de separación de privilegios (/run/sshd en Debian: lo crea
# ssh.service al arrancar, y tras un reinicio con activación por socket aún no existe), se crea como
# lo haría la unidad (root, 0755) y se repite. Si sigue fallando, imprime el error y devuelve 1.
sshd_test() {
  local out dir
  out=$(sshd -t 2>&1) && return 0
  # Sin `\r`: con la salida en una terminal, sshd acaba las líneas en CRLF.
  dir=$(printf '%s\n' "$out" | tr -d '\r' | sed -n 's|^Missing privilege separation directory: \(/[A-Za-z0-9_./-]*\)$|\1|p' | head -1)
  if [ -n "$dir" ] && [ ! -e "$dir" ]; then
    install -d -m 0755 -o root -g root "$dir"
    out=$(sshd -t 2>&1) && return 0
  fi
  printf '%s\n' "$out"
  return 1
}

# Configura sshd para que <usuario> acepte certificados de la CA de InfraWard con el principal
# <usuario> y nada más. Todo dentro de `Match User`: no afecta a otros usuarios ni a otra CA que
# ya tenga el servidor. Si `sshd -t` falla o la configuración efectiva no es la nuestra (falta el
# Include de sshd_config.d, u otro fichero anterior fija esos valores), se restaura lo anterior y
# no se recarga. El sshd_config principal no se toca nunca.
configure_ssh_ca() {
  local user=$1 keys=$2 ca_version=$3
  local dir=/etc/ssh/infraward
  local ca_file=$dir/trusted_user_ca_keys
  local principals=$dir/principals
  local dropin_dir=/etc/ssh/sshd_config.d
  local dropin=$dropin_dir/00-infraward.conf
  local version_file=/etc/infraward/ssh-ca-version
  [ -d "$dropin_dir" ] ||
    die "no existe $dropin_dir; añade 'Include $dropin_dir/*.conf' al principio de /etc/ssh/sshd_config y vuelve a ejecutar el script"

  # Copia de lo que haya para poder dejarlo como estaba.
  local backup f saved
  backup=$(mktemp -d)
  for f in "$ca_file" "$principals/$user" "$dropin" "$version_file"; do
    if [ -e "$f" ]; then cp -p "$f" "$backup/$(printf '%s' "$f" | tr / _)"; fi
  done
  restore_ssh_ca() {
    for f in "$ca_file" "$principals/$user" "$dropin" "$version_file"; do
      saved="$backup/$(printf '%s' "$f" | tr / _)"
      if [ -e "$saved" ]; then cp -p "$saved" "$f"; else rm -f "$f"; fi
    done
    rm -rf "$backup"
  }

  local tmp
  install -d -m 755 "$dir" "$principals"
  tmp=$(mktemp)
  {
    printf '# infraward-ssh-ca-version: %s\n' "$ca_version"
    printf '# CA SSH de InfraWard. Generado por el script de alta: no editar.\n'
    printf '%s\n' "$keys"
  } >"$tmp"
  install -m 644 -o root -g root "$tmp" "$ca_file"
  printf '%s\n' "$user" >"$tmp"
  install -m 644 -o root -g root "$tmp" "$principals/$user"
  {
    printf '# infraward-ssh-ca-version: %s\n' "$ca_version"
    printf '# Generado por el script de alta de InfraWard: no editar. El usuario %s solo entra\n' "$user"
    printf '# con certificados de vida corta de la CA de InfraWard y con el principal %s.\n' "$user"
    printf 'Match User %s\n' "$user"
    printf '    TrustedUserCAKeys %s\n' "$ca_file"
    printf '    AuthorizedPrincipalsFile %s/%%u\n' "$principals"
    printf '    PermitTTY no\n'
    printf '    DisableForwarding yes\n'
    printf '    PermitUserRC no\n'
  } >"$tmp"
  install -m 644 -o root -g root "$tmp" "$dropin"
  rm -f "$tmp"

  local err
  if ! err=$(sshd_test); then
    restore_ssh_ca
    die "la configuración de sshd no es válida; se ha dejado como estaba: $(printf '%s' "$err" | head -1)"
  fi
  local effective
  if ! effective=$(sshd -T -C "user=$user,host=localhost,addr=127.0.0.1" 2>/dev/null); then
    restore_ssh_ca
    die "no se pudo leer la configuración efectiva de sshd; se ha dejado como estaba"
  fi
  if ! printf '%s\n' "$effective" | grep -qixF "trustedusercakeys $ca_file" ||
    ! printf '%s\n' "$effective" | grep -qixF "authorizedprincipalsfile $principals/%u"; then
    restore_ssh_ca
    die "sshd no aplica $dropin (¿falta 'Include $dropin_dir/*.conf' al principio de sshd_config, u otro fichero lo fija antes?); se ha dejado como estaba"
  fi

  install -d -m 755 /etc/infraward
  printf '%s\n' "$ca_version" >"$version_file"
  chmod 644 "$version_file"
  rm -rf "$backup"
  reload_sshd
}

# Acceso interactivo de administración (DESIGN §7), variante `operator`: la cuenta
# `infraward-admin` con sudo sin contraseña (el certificado dura minutos, se emite tras MFA y
# queda auditado), que solo entra con certificados de la CA de InfraWard con el principal de rol
# `infraward-operators`: sin claves (`AuthorizedKeysFile none`) ni contraseñas. Quién recibe esos
# certificados lo decide InfraWard: dar o quitar acceso a una persona no toca el servidor.
# Su propio drop-in (`Match User infraward-admin`): la configuración de `inventory` no cambia (se
# comprueba comparando su configuración efectiva antes y después). Idempotente: si nada cambia
# no se reescribe ningún fichero ni se recarga sshd. Si `sshd -t`, visudo o la configuración
# efectiva fallan, se deja todo como estaba.
configure_admin_access() {
  local inventory_user=$1 admin_version=$2
  local ca_file=/etc/ssh/infraward/trusted_user_ca_keys
  local principals_dir
  principals_dir=$(dirname "$ADMIN_PRINCIPALS")
  [ -s "$ca_file" ] || die "falta $ca_file (el acceso de administración requiere el modo CA)"

  local backup f saved created=0
  backup=$(mktemp -d)
  for f in "$ADMIN_DROPIN" "$ADMIN_SUDOERS" "$ADMIN_PRINCIPALS" "$ADMIN_VERSION_FILE"; do
    if [ -e "$f" ]; then cp -p "$f" "$backup/$(printf '%s' "$f" | tr / _)"; fi
  done
  restore_admin_access() {
    for f in "$ADMIN_DROPIN" "$ADMIN_SUDOERS" "$ADMIN_PRINCIPALS" "$ADMIN_VERSION_FILE"; do
      saved="$backup/$(printf '%s' "$f" | tr / _)"
      if [ -e "$saved" ]; then cp -p "$saved" "$f"; else rm -f "$f"; fi
    done
    if [ "$created" -eq 1 ]; then
      userdel -r "$ADMIN_USER" >/dev/null 2>&1 || true
      rm -f "$ADMIN_CREATED_MARK"
    fi
    rm -rf "$backup"
  }

  # Configuración efectiva de inventory antes de tocar nada: no puede cambiar.
  local inventory_before
  inventory_before=$(sshd -T -C "user=$inventory_user,host=localhost,addr=127.0.0.1" 2>/dev/null) ||
    die "no se pudo leer la configuración efectiva de sshd"

  if ! id "$ADMIN_USER" >/dev/null 2>&1; then
    useradd --create-home --home-dir "/home/$ADMIN_USER" --shell /bin/bash \
      --comment "InfraWard (administración interactiva)" "$ADMIN_USER"
    created=1
    install -d -m 755 /etc/infraward
    printf '%s\n' "$ADMIN_USER" >"$ADMIN_CREATED_MARK"
    chmod 644 "$ADMIN_CREATED_MARK"
  fi
  if [ "$(id -u "$ADMIN_USER")" -eq 0 ]; then
    restore_admin_access
    die "el usuario '$ADMIN_USER' tiene uid 0; no se toca"
  fi
  # '*' y no '!': sin contraseña posible, pero sin bloquear la cuenta (con UsePAM=no, sshd no deja
  # entrar a una cuenta bloqueada ni con certificado). Desbloquea si se retiró con sesiones vivas.
  usermod -p '*' -e '' "$ADMIN_USER" 2>/dev/null || usermod -p '*' "$ADMIN_USER"

  local changed=0 tmp
  # sudoers: el nombre temporal lleva un punto (sudo lo ignora mientras se valida).
  tmp=$(mktemp /etc/sudoers.d/.infraward-admin.XXXXXX)
  {
    printf '# infraward-admin-access-version: %s\n' "$admin_version"
    printf '# Generado por el script de alta de InfraWard: no editar. Acceso interactivo de\n'
    printf '# administración: la cuenta %s solo entra con certificados de pocos minutos de la\n' "$ADMIN_USER"
    printf '# CA de InfraWard, emitidos tras MFA a las personas autorizadas (ver %s).\n' "$ADMIN_DROPIN"
    printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$ADMIN_USER"
  } >"$tmp"
  chmod 440 "$tmp"
  if ! visudo -cqf "$tmp"; then
    rm -f "$tmp"
    restore_admin_access
    die "el sudoers de $ADMIN_USER no es válido; se ha dejado todo como estaba"
  fi
  if cmp -s "$tmp" "$ADMIN_SUDOERS"; then rm -f "$tmp"; else mv -f "$tmp" "$ADMIN_SUDOERS"; changed=1; fi

  install -d -m 755 "$principals_dir"
  tmp=$(mktemp)
  printf '%s\n' "$ADMIN_PRINCIPAL" >"$tmp"
  install_if_changed "$tmp" "$ADMIN_PRINCIPALS" 644 && changed=1
  {
    printf '# infraward-admin-access-version: %s\n' "$admin_version"
    printf '# Generado por el script de alta de InfraWard: no editar. La cuenta %s solo entra\n' "$ADMIN_USER"
    printf '# con certificados de vida corta de la CA de InfraWard con el principal %s:\n' "$ADMIN_PRINCIPAL"
    printf '# ni claves en authorized_keys ni contraseñas.\n'
    printf 'Match User %s\n' "$ADMIN_USER"
    printf '    TrustedUserCAKeys %s\n' "$ca_file"
    printf '    AuthorizedPrincipalsFile %s/%%u\n' "$principals_dir"
    printf '    AuthorizedKeysFile none\n'
    printf '    PasswordAuthentication no\n'
    printf '    KbdInteractiveAuthentication no\n'
    printf '    PermitTTY yes\n'
    printf '    DisableForwarding yes\n'
    printf '    PermitUserRC no\n'
  } >"$tmp"
  install_if_changed "$tmp" "$ADMIN_DROPIN" 644 && changed=1
  rm -f "$tmp"

  local err effective inventory_after
  if ! err=$(sshd_test); then
    restore_admin_access
    die "la configuración de sshd no es válida; se ha dejado como estaba: $(printf '%s' "$err" | head -1)"
  fi
  if ! effective=$(sshd -T -C "user=$ADMIN_USER,host=localhost,addr=127.0.0.1" 2>/dev/null); then
    restore_admin_access
    die "no se pudo leer la configuración efectiva de sshd; se ha dejado como estaba"
  fi
  local want
  for want in "trustedusercakeys $ca_file" "authorizedprincipalsfile $principals_dir/%u" \
    "authorizedkeysfile none" "passwordauthentication no" "permittty yes"; do
    if ! printf '%s\n' "$effective" | grep -qixF "$want"; then
      restore_admin_access
      die "sshd no aplica $ADMIN_DROPIN ('$want'; ¿otro fichero lo fija antes?); se ha dejado como estaba"
    fi
  done
  # OpenSSH < 8.7 la llama challengeresponseauthentication.
  if ! printf '%s\n' "$effective" | grep -qixE '(kbdinteractive|challengeresponse)authentication no'; then
    restore_admin_access
    die "sshd no desactiva el teclado interactivo para $ADMIN_USER; se ha dejado como estaba"
  fi
  inventory_after=$(sshd -T -C "user=$inventory_user,host=localhost,addr=127.0.0.1" 2>/dev/null) || true
  if [ "$inventory_before" != "$inventory_after" ]; then
    restore_admin_access
    die "la configuración de $ADMIN_USER cambiaría la de $inventory_user; se ha dejado como estaba"
  fi

  tmp=$(mktemp)
  printf '%s\n' "$admin_version" >"$tmp"
  install -d -m 755 /etc/infraward
  install_if_changed "$tmp" "$ADMIN_VERSION_FILE" 644 && changed=1
  rm -f "$tmp"
  rm -rf "$backup"
  if [ "$changed" -eq 1 ]; then reload_sshd; else log "Acceso de administración ya al día (sin cambios)"; fi
}

# Retira el acceso de administración: drop-in, sudoers y principales. La cuenta solo se borra si
# la creó InfraWard y no tiene procesos; si los tiene (una sesión abierta), se bloquea y caduca.
remove_admin_access() {
  local had=0 f
  for f in "$ADMIN_DROPIN" "$ADMIN_SUDOERS" "$ADMIN_PRINCIPALS" "$ADMIN_VERSION_FILE"; do
    if [ -e "$f" ]; then rm -f "$f"; had=1; fi
  done
  if [ -f "$ADMIN_CREATED_MARK" ] && id "$ADMIN_USER" >/dev/null 2>&1; then
    if [ "$(id -u "$ADMIN_USER")" -ne 0 ] && ! pgrep -u "$ADMIN_USER" >/dev/null 2>&1 &&
      userdel -r "$ADMIN_USER" >/dev/null 2>&1; then
      rm -f "$ADMIN_CREATED_MARK"
    else
      usermod -L -e 1 "$ADMIN_USER" 2>/dev/null || usermod -L "$ADMIN_USER" || true
      log "AVISO: $ADMIN_USER tiene procesos en marcha: se ha bloqueado; vuelve a ejecutar el script para borrarla"
    fi
    had=1
  fi
  if [ "$had" -eq 0 ]; then return 0; fi
  log "Acceso interactivo de administración retirado"
  local err
  err=$(sshd_test) || die "la configuración de sshd no es válida tras retirar el acceso de administración: $(printf '%s' "$err" | head -1)"
  reload_sshd
}

# Instala <tmp> en <destino> (root:root, <modo>) solo si cambia. Devuelve 0 si lo instaló.
install_if_changed() {
  local tmp=$1 dest=$2 mode=$3
  if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then return 1; fi
  install -m "$mode" -o root -g root "$tmp" "$dest"
}

# Recarga sshd para que lea la configuración nueva (las conexiones abiertas siguen).
reload_sshd() {
  if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    local unit
    for unit in ssh sshd; do
      if systemctl is-active --quiet "$unit.service" 2>/dev/null; then
        systemctl reload "$unit.service" && return 0
      fi
    done
    # Activación por socket: cada conexión arranca un sshd que lee la configuración.
    if systemctl is-active --quiet ssh.socket 2>/dev/null; then return 0; fi
  fi
  if command -v rc-service >/dev/null 2>&1 && rc-service sshd status >/dev/null 2>&1; then
    rc-service sshd reload && return 0
  fi
  local pidfile
  for pidfile in /run/sshd.pid /var/run/sshd.pid; do
    if [ -s "$pidfile" ]; then
      kill -HUP "$(cat "$pidfile")" && return 0
    fi
  done
  die "no se pudo recargar sshd; recárgalo a mano (p. ej. systemctl reload ssh)"
}

# Instala sudo con el gestor de paquetes que haya. Solo con --install-sudo (opt-in explícito).
install_sudo_package() {
  log "Instalando sudo (--install-sudo)"
  if command -v apt-get >/dev/null; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q sudo >/dev/null ||
      { apt-get update -q >/dev/null && DEBIAN_FRONTEND=noninteractive apt-get install -y -q sudo >/dev/null; }
  elif command -v dnf >/dev/null; then
    dnf install -y -q sudo >/dev/null
  elif command -v yum >/dev/null; then
    yum install -y -q sudo >/dev/null
  elif command -v apk >/dev/null; then
    apk add --quiet sudo >/dev/null
  elif command -v zypper >/dev/null; then
    zypper --non-interactive --quiet install sudo >/dev/null
  else
    die "no se reconoce el gestor de paquetes; instala sudo a mano"
  fi || die "no se pudo instalar sudo"
  if ! command -v sudo >/dev/null || ! command -v visudo >/dev/null; then
    die "se instaló el paquete sudo, pero no se encuentran 'sudo' y 'visudo'"
  fi
}

# sudoers v4: una sola regla, el ayudante de root. Sin argumentos en la regla, sudo (y sudo-rs)
# permite cualquiera: el filtro es el ayudante, que solo admite su lista cerrada de consultas.
write_sudoers() {
  local user=$1 file=$2 version=$3
  local tmp
  # El nombre lleva un punto: sudo ignora ese fichero mientras se valida.
  tmp=$(mktemp /etc/sudoers.d/.infraward.XXXXXX)
  {
    cat <<EOF
# infraward-sudoers-version: $version
# Generado por el script de alta de InfraWard. No editar: se reescribe al volver a ejecutarlo.
# Usuario de inventario: nunca ALL, solo el ayudante $QUERY_HELPER
# (root:root 0755), que admite una lista CERRADA de consultas de solo lectura, valida cada
# argumento y ejecuta el comando sin shell en medio. Así vale igual con sudo y con sudo-rs, que
# no admite comodines, espacios ni expresiones regulares en los argumentos.
#
# AVISO: en nodos Proxmox y hosts Docker la lista es más documentación de intenciones que una
# barrera real:
#   - 'pct-exec' ejecuta como root dentro de los CT del nodo (y un CT privilegiado no aísla del
#     host): así se recogen con Ansible; el ayudante valida el vmid, no el comando.
#   - Docker: solo consultas de lectura (y 'docker save' de una imagen por su id, a la salida
#     estándar, para escanearla), pero 'docker inspect' expone la configuración de los
#     contenedores y cualquier acceso al demonio de Docker equivale a root. No añadas '$user' al
#     grupo docker.
# En servidores sin Proxmox ni Docker el ayudante sí limita lo que puede hacer el usuario.
EOF
    # sudo-rs (Ubuntu ≥ 25.10) no conoce estas opciones (nunca pide tty ni da el sermón).
    sudo_is_rs || printf 'Defaults:%s !requiretty, !lecture\n' "$user"
    printf '%s ALL=(root) NOPASSWD: %s\n' "$user" "$QUERY_HELPER"
  } >"$tmp"
  chmod 440 "$tmp"
  if ! visudo -cqf "$tmp"; then
    rm -f "$tmp"
    die "el sudoers generado no es válido; no se ha cambiado nada"
  fi
  mv -f "$tmp" "$file"
}

# sudo-rs (el sudo en Rust de Ubuntu ≥ 25.10): sin comodines ni espacios en los argumentos de
# las reglas, ni expresiones regulares, ni `Defaults !requiretty`. `sudo -V` imprime
# «sudo-rs <versión>» (en stderr).
sudo_is_rs() {
  sudo -V 2>&1 | head -n 1 | grep -q '^sudo-rs'
}

# Falla si <dir> o alguno de sus padres no es de root o lo puede escribir alguien más (cualquiera
# o un grupo que no es root): podría sustituir el ayudante.
check_root_only_path() {
  local d=$1 uid gid mode
  while :; do
    read -r uid gid mode <<<"$(stat -c '%u %g %a' "$d")" || die "no se puede comprobar $d"
    if [ "$uid" -ne 0 ] || (((8#$mode & 8#002) != 0)) ||
      { (((8#$mode & 8#020) != 0)) && [ "$gid" -ne 0 ]; }; then
      die "$d lo puede modificar alguien que no es root (dueño $uid, grupo $gid, permisos $mode); no se instala el ayudante"
    fi
    [ "$d" = / ] && break
    d=$(dirname "$d")
  done
}

# Ayudante de root `infraward-query <consulta> [argumentos…]` (sudoers v4, DESIGN §7). Lista
# CERRADA de consultas, la misma que PRIVILEGED_QUERIES en packages/connectors/src/privileged.ts
# (un test de la API ejecuta este ayudante con binarios falsos y compara una a una, y otro
# intenta inyectar argumentos). Valida aridad y cada argumento ANTES de ejecutar nada (si algo
# no cuadra, sale con 64) y ejecuta el binario con `exec`, sin shell en medio. Las consultas de
