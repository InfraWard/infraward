NETWORK_FORMAT='{"id":{{json .Id}},"name":{{json .Name}},"driver":{{json .Driver}},"scope":{{json .Scope}},"internal":{{json .Internal}},"createdAt":{{json .Created}},"subnets":[{{range .IPAM.Config}}{"subnet":{{json .Subnet}},"gateway":{{json .Gateway}}},{{end}}null]}'

reject() {
  printf 'infraward-query: rechazado: %s\n' "$*" >&2
  exit 64
}
# run <binario> <argumentos…>: el binario del PATH fijo, sin shell en medio.
run() {
  local bin
  bin=$(type -P -- "$1") || {
    printf 'infraward-query: falta %s\n' "$1" >&2
    exit 127
  }
  shift
  exec "$bin" "$@"
}
# arity <mín> <máx>: número de argumentos de la consulta.
arity() {
  [ "$nargs" -ge "$1" ] && [ "$nargs" -le "$2" ] || reject "$query: número de argumentos no válido"
}
# check <posición> <expresión> <valor>
check() {
  [[ $3 =~ $2 ]] || reject "$query: argumento $1 no válido"
}
# each <expresión> <valores…>: de 1 a MAX_INSPECT valores, todos válidos.
each() {
  local re=$1 a i=0
  shift
  arity 1 "$MAX_INSPECT"
  for a in "$@"; do
    i=$((i + 1))
    [[ $a =~ $re ]] || reject "$query: argumento $i no válido"
  done
}
# guest <nodo> <lxc|qemu> <vmid>: el guest existe en ese nodo.
guest() {
  local dir=$2
  [ "$dir" = qemu ] && dir=qemu-server
  [ -f "$PVE_DIR/nodes/$1/$dir/$3.conf" ] || reject "$query: no existe $2 $3 en el nodo $1"
}
plesk_db() {
  run plesk db -B -N -r -e "$1"
}

[ $# -ge 1 ] || reject "falta la consulta"
query=$1
shift
nargs=$#
case $query in
