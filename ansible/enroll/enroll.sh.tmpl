"$S" -T -C user=root,host=localhost,addr=127.0.0.1 2>/dev/null | awk '
$1 == "permitrootlogin" || $1 == "passwordauthentication" || $1 == "kbdinteractiveauthentication" || $1 == "challengeresponseauthentication" { print $1 "\t" $2 }
