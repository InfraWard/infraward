{
  "name": "infraward",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm -r --filter \"./packages/*\" build && pnpm -r --parallel run \"/^(dev|start:dev|dev:gateway)$/\"",
    "infra:up": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d",
    "infra:down": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env down",
    "openbao:bootstrap": "bash deploy/openbao/bootstrap.sh",
    "keycloak:bootstrap": "bash deploy/keycloak/bootstrap.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "prettier": "^3.8.1"
  }
}
