# Copiar a apps/api/.env (ignorado por git) y ajustar. Las variables de entorno reales tienen prioridad.
NODE_ENV=development
PORT=3000

# Debe coincidir con deploy/.env (POSTGRES_*).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=infraward
DATABASE_PASSWORD=change-me
DATABASE_NAME=infraward

# Redis de la cola (BullMQ). Debe coincidir con deploy/.env (REDIS_PORT) y con el worker.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# O, mejor, desde un fichero (no se ve en el entorno del proceso ni en `docker inspect`):
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_DB=0

# Sesión web (DESIGN §14): cookie httpOnly + token CSRF; la sesión vive en la BD (user_sessions).
# Caducidad absoluta y por inactividad, en segundos.
SESSION_TTL=43200
SESSION_IDLE_TTL=7200
# Cookie Secure con el prefijo __Host- (por defecto). Solo fuera de producción se puede poner a
# false (un navegador que no acepte cookies Secure en http://localhost, como Safari).
# SESSION_COOKIE_SECURE=true
# Validez de las contraseñas temporales (alta y restablecimiento), en segundos.
TEMP_PASSWORD_TTL=86400
# Orígenes de la web separados por comas (cabecera Origin de las escrituras). Por defecto, el de
# PUBLIC_URL y, en desarrollo, también http://localhost:4200.
# WEB_ORIGIN=https://infraward.example.com
# Proxies de confianza para la IP real del cliente (auditoría y límite de login): false, true o
# una lista (loopback, 10.0.0.0/8…). En desarrollo, el proxy de ng serve está en loopback.
TRUST_PROXY=loopback
# En producción, la dirección exacta del proxy inverso: con un valor amplio (true, uniquelocal),
# los clientes de ese rango pueden falsear X-Forwarded-For y saltarse los límites por IP.

# Límite de intentos de login por IP: LIMIT intentos cada TTL segundos (y bloqueo de TTL al superarlo).
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60
# Límite de logins FALLIDOS por cuenta (el email), desde cualquier IP: LIMIT fallos cada TTL
# segundos. No bloquea las redes desde las que la cuenta ya entró bien en los últimos 30 días.
LOGIN_ACCOUNT_THROTTLE_LIMIT=10
LOGIN_ACCOUNT_THROTTLE_TTL=300
# Contadores de los límites: redis (por defecto, compartidos por las réplicas de la API) o memory
# (por proceso).
# THROTTLE_STORAGE=redis
# Los códigos TOTP y de recuperación usan el mismo límite, pero por usuario (DESIGN §14).

# Reautenticación reciente (step-up): las acciones sensibles (purgar, cambiar roles, desactivar
# usuarios, tokens de escritura…) piden confirmar la identidad si pasó más de esto (segundos).
REAUTH_MAX_AGE=600

# Caché de los datos de cada widget del panel (segundos; 0 la desactiva). Las tareas en curso, 5 s.
DASHBOARD_CACHE_TTL=30

# Login con OIDC (DESIGN §14; opcional: lo activa OIDC_ISSUER). En desarrollo, pnpm keycloak:bootstrap
# levanta un Keycloak de pruebas, guarda el secreto del cliente y muestra estas líneas.
# El secreto del cliente va SIEMPRE como referencia al proveedor de secretos, nunca en claro.
# OIDC_ISSUER=http://localhost:8081/realms/infraward
# OIDC_CLIENT_ID=infraward
# OIDC_CLIENT_SECRET_REF=secret://local/oidc/keycloak#client_secret
# OIDC_REDIRECT_URI=http://localhost:4200/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=Keycloak
# grupo=rol separados por comas; con varios grupos gana el rol con más permisos.
# OIDC_ROLE_MAPPING=infraward-admins=admin,infraward-editors=editor,infraward-operators=operator,infraward-auditors=auditor,infraward-viewers=viewer
# Claim con los grupos (admite ruta con puntos, p. ej. realm_access.roles).
# OIDC_GROUPS_CLAIM=groups
# Sin ningún grupo con rol: deny (por defecto) o viewer.
# OIDC_UNMAPPED=deny
# Alta automática aunque el proveedor no marque email_verified (p. ej. Entra ID, que no lo manda).
# Por defecto false: sin email verificado no se crea la cuenta. El enlace con una cuenta local
# siempre lo exige.
# OIDC_ALLOW_UNVERIFIED_SIGNUP=false
# OIDC_SCOPES=openid email profile
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Login con contraseña: con false solo entra el admin local de emergencia (exige OIDC). Guarda su
# contraseña fuera de línea; es la puerta de entrada si el proveedor falla.
# LOCAL_LOGIN=true
# LOCAL_LOGIN_EMERGENCY_EMAIL=admin@example.com

# Administrador inicial: se crea al arrancar solo si no existe ningún usuario.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Secretos (ver docs/DESIGN.md §6). Proveedores activos, separados por comas.
SECRETS_PROVIDERS=local
# Clave maestra del proveedor local: 32 bytes en base64. Generar con: openssl rand -base64 32
# Usar SOLO UNA de las dos variables. En producción, el fichero (secret de Podman/Docker):
# las variables de entorno se filtran con facilidad (inspect, /proc/<pid>/environ, volcados).
#   (umask 177; openssl rand -base64 32 > deploy/secrets/master.key)
# ¡IMPORTANTE! Sin esta clave los secretos guardados son irrecuperables: una copia de la BD
# sin la clave no sirve. Haz copia de la clave, pero NUNCA en el mismo backup que la BD.
SECRETS_LOCAL_MASTER_KEY_FILE=/ruta/absoluta/a/deploy/secrets/master.key
# SECRETS_LOCAL_MASTER_KEY=
# OpenBao (si SECRETS_PROVIDERS incluye openbao, p. ej. openbao,local: las claves nuevas van al
# primero que admite escritura). Autenticación por AppRole, nunca con un token root.
# En desarrollo: pnpm openbao:bootstrap (crea la política, el rol y el fichero del secret_id).
# Con una CA propia en https, NODE_EXTRA_CA_CERTS=/ruta/ca.pem.
# OPENBAO_ADDR=http://127.0.0.1:8200
# OPENBAO_ROLE_ID=
# OPENBAO_SECRET_ID_FILE=/ruta/absoluta/a/deploy/secrets/openbao-secret-id
# OPENBAO_SECRET_ID=
# OPENBAO_KV_MOUNT=secret
# OPENBAO_KV_PREFIX=infraward
# OPENBAO_APPROLE_MOUNT=approle
# OPENBAO_TIMEOUT_MS=5000
# CA SSH (certificados de vida corta; DESIGN §6): montaje del motor SSH y rol de firma.
# OPENBAO_SSH_MOUNT=infraward-ssh
# OPENBAO_SSH_ROLE=inventory
# Límite de POST /secrets/check por usuario: LIMIT comprobaciones cada TTL segundos (y bloqueo de TTL).
SECRETS_CHECK_THROTTLE_LIMIT=30
SECRETS_CHECK_THROTTLE_TTL=60
# Vida de la caché de secretos en memoria, en segundos (0 = sin caché, máx. 300).
SECRETS_CACHE_TTL=60

# Caja fuerte de credenciales (ver docs/DESIGN.md §19): contraseñas de consola, paneles web, IPMI…
# que usa una persona y que InfraWard nunca usa para conectarse. SOLO la API: el worker no lleva
# ninguna de estas variables y no puede leerla. Almacén: none (desactivada), local u openbao.
# VAULT_PROVIDER=local
# Local: tabla vault_local_secrets cifrada con SU PROPIA clave (distinta de la de arriba; la API
# no arranca si es la misma). Generar con:
#   (umask 177; openssl rand -base64 32 > deploy/secrets/vault.master.key)
# Sin ella las credenciales son irrecuperables: copia aparte, nunca con el backup de la BD.
# VAULT_LOCAL_MASTER_KEY_FILE=/ruta/absoluta/a/deploy/secrets/vault.master.key
# OpenBao: mismo OPENBAO_ADDR y montajes, pero su propia AppRole (infraward-vault) y su prefijo
# (infraward-vault/, fuera del de la app). pnpm openbao:bootstrap la crea.
# VAULT_PROVIDER=openbao
# VAULT_OPENBAO_ROLE_ID=
# VAULT_OPENBAO_SECRET_ID_FILE=/ruta/absoluta/a/deploy/secrets/openbao/vault-secret-id
# VAULT_OPENBAO_KV_PREFIX=infraward-vault
# Versiones del secreto que se conservan por entrada (1–100).
# VAULT_MAX_VERSIONS=10
# Revelados por usuario: LIMIT cada TTL segundos.
# VAULT_REVEAL_THROTTLE_LIMIT=20
# VAULT_REVEAL_THROTTLE_TTL=600

# Terminal interactiva a través del gateway (ver docs/DESIGN.md §11). SOLO la API firma los
# certificados de la terminal, con su propia AppRole (infraward-terminal, que crea
# pnpm openbao:bootstrap): ni el worker ni el gateway llevan estas variables.
# TERMINAL_OPENBAO_ROLE_ID=
# TERMINAL_OPENBAO_SECRET_ID_FILE=/ruta/absoluta/a/deploy/secrets/openbao/terminal-secret-id
# TERMINAL_OPENBAO_SSH_ROLE=infraward-operator
# Vida de cada certificado (30–300 s; la sesión sigue aunque caduque).
# TERMINAL_CERT_TTL=120
# Secreto compartido con el gateway (rutas internas /internal/gateway/*). Generar con:
#   (umask 177; openssl rand -base64 48 > deploy/secrets/gateway-api.secret)
# GATEWAY_API_SECRET_FILE=/ruta/absoluta/a/deploy/secrets/gateway-api.secret
# Dónde conecta el navegador con el gateway (sin /terminal): una ruta del mismo origen que la web,
# que hace de proxy (proxy.conf.json en desarrollo, nginx en la imagen web). La cookie de la
# sesión viaja en el upgrade y el gateway exige que sea la de la sesión que pidió el ticket.
# GATEWAY_PUBLIC_URL=/gateway
# Sin latido del gateway durante tantos segundos, el barrido da la terminal por perdida (y cada
# cuánto barre).
# TERMINAL_HEARTBEAT_TIMEOUT=60
# TERMINAL_SWEEP_INTERVAL=30

# Alta de servidores (ver docs/DESIGN.md §7).
# URL con la que los servidores llegan a la API: el script se descarga de <PUBLIC_URL>/enroll/<token>.
# En producción, https y el dominio público (sin barra final).
PUBLIC_URL=http://localhost:3000
# Validez del token de un solo uso, en segundos (900–1800).
ENROLLMENT_TOKEN_TTL=1200
# Límite de /enroll/* (públicos) por IP: LIMIT peticiones cada TTL segundos (y bloqueo de TTL).
ENROLL_THROTTLE_LIMIT=20
ENROLL_THROTTLE_TTL=60
# Plantilla del script de alta; por defecto la del repositorio (ansible/enroll/enroll.sh.tmpl).
# ENROLL_SCRIPT_TEMPLATE=

# Referencia de la API (/docs) y documento OpenAPI (/openapi.json) sin autenticación: true o
# false. Sin definir: activos fuera de producción y apagados en producción.
# DOCS_PUBLIC=false
