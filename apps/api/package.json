{
  "name": "@infraward/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "API de InfraWard (NestJS)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --coverage.reporter=lcovonly --coverage.reporter=text-summary",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:show": "pnpm typeorm migration:show",
    "migration:generate": "pnpm build && typeorm migration:generate -p -d dist/database/data-source.js",
    "secrets:put": "node dist/cli/secret-put.js",
    "migration:check": "typeorm migration:generate --check -d dist/database/data-source.js src/database/migrations/Check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@infraward/connectors": "workspace:*",
    "@infraward/domain": "workspace:*",
    "@infraward/secrets": "workspace:*",
    "@infraward/shared-types": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@scalar/nestjs-api-reference": "^1.2.27",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@infraward/worker": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.0",
    "jose": "^6.2.12",
    "source-map-support": "^0.5.21",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "ws": "8.22.0"
  }
}
