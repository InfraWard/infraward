# Modo gateway del worker (terminal, ver docs/DESIGN.md §11): cp .env.gateway.example .env.gateway
# y `pnpm --filter @infraward/worker start:gateway` (tras compilar). Es OTRO fichero que el .env del
# worker a propósito: el gateway nunca accede al gestor de secretos y no arranca si recibe
# SECRETS_*, OPENBAO_*, VAULT_* o TERMINAL_OPENBAO_*.

# Redis (cupos de sesiones por host y por persona, e identidad gateway-<n>).
REDIS_HOST=localhost
REDIS_PORT=6379
# Contraseña de Redis, si tiene: REDIS_PASSWORD o, mejor, REDIS_PASSWORD_FILE (un fichero).
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# REDIS_DB=0

# Base de datos: solo lee el inventario (rutas de los assets).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=infraward
DATABASE_PASSWORD=change-me-db-password
DATABASE_NAME=infraward

# La API (canje de los tickets y firma de los certificados) y el secreto compartido con ella
# (el mismo fichero que GATEWAY_API_SECRET_FILE de la API).
GATEWAY_API_URL=http://localhost:3000
GATEWAY_API_SECRET_FILE=/ruta/absoluta/a/deploy/secrets/gateway-api.secret

# WebSocket en ws://<host>:<puerto>/terminal; el navegador llega por la web (/gateway/terminal,
# proxy.conf.json en desarrollo), así la cookie de la sesión viaja en el upgrade.
# GATEWAY_PORT=3010
# GATEWAY_HOST=0.0.0.0
# Orígenes web que pueden abrir el WebSocket (sin Origin, p. ej. el cliente de pruebas, siempre).
# WEB_ORIGIN=http://localhost:4200
# GATEWAY_NAME=gateway-1

# Latido a la API con las sesiones abiertas (segundos; menor que TERMINAL_HEARTBEAT_TIMEOUT).
# GATEWAY_HEARTBEAT_INTERVAL=15

# Parada ordenada: aviso a las sesiones y cierre limpio a los N segundos (con pnpm dev, que lo
# reinicia al recompilar el worker, mejor pocos: GATEWAY_SHUTDOWN_GRACE=5).
# GATEWAY_SHUTDOWN_GRACE=60
# Sesiones a la vez por servidor (aparte de los jobs) y por persona; tiempos (segundos).
# HOST_MAX_TERMINAL_SESSIONS=4
# TERMINAL_MAX_SESSIONS_PER_USER=3
# TERMINAL_IDLE_TIMEOUT=900
# TERMINAL_MAX_DURATION=28800

# Claves efímeras de cada sesión (tmpfs; por defecto /dev/shm) y tiempo de conexión SSH.
# WORKER_TMP_DIR=/dev/shm
# SSH_CONNECT_TIMEOUT=15
