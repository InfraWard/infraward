# Copiar a apps/worker/.env (ignorado por git) y ajustar. Las variables de entorno reales tienen prioridad.
NODE_ENV=development

# Redis de la cola (BullMQ). Debe coincidir con deploy/.env (REDIS_PORT) y con la API.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# O, mejor, desde un fichero (no se ve en el entorno del proceso ni en `docker inspect`):
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_DB=0

# Paralelismo (DESIGN §20): jobs a la vez de cada tipo en esta réplica (0 = no los hace).
# system (consultas, KEV/EPSS, prioridad, métricas) y enrollment (verificación del alta).
WORKER_CONCURRENCY=5
COLLECT_CONCURRENCY=4
DISCOVERY_CONCURRENCY=2
DOMAINS_SYNC_CONCURRENCY=2
RECONCILE_CONCURRENCY=1
IMAGE_SCAN_CONCURRENCY=1
HOST_SCAN_CONCURRENCY=1
SBOM_CONCURRENCY=1
# Jobs a la vez contra un mismo servidor (un CT cuenta contra su nodo), sumando todas las
# réplicas; de ellos, escaneos y rellenos de SBOMs.
HOST_MAX_JOBS=2
HOST_MAX_SCAN_JOBS=1
# Nombre en la Actividad (por defecto worker-<n>, el menor libre).
# WORKER_NAME=
# Si puede ser el líder (jobs periódicos, Actividad, huérfanos). Los workers remotos, false.
# WORKER_LEADER_ELIGIBLE=true
# Segundos que se espera a los jobs en curso al parar (después vuelven a la cola).
WORKER_SHUTDOWN_GRACE=90

# Días que se conserva el historial de ejecuciones (Actividad).
JOB_RUNS_RETENTION_DAYS=30

# Log de cada ejecución (recolecciones, escaneos…; se ve en la ficha del asset): días que se
# conserva (nunca más que el historial de arriba) y tope de tamaño por ejecución en KiB.
COLLECTION_LOG_RETENTION_DAYS=30
COLLECTION_LOG_MAX_KB=256

# Base de datos: la misma que la API (el worker lee y actualiza el inventario; no migra).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=infraward
DATABASE_PASSWORD=change-me
DATABASE_NAME=infraward

# Secretos: los mismos proveedores y la MISMA clave maestra que la API (ver apps/api/.env.example).
SECRETS_PROVIDERS=local
SECRETS_LOCAL_MASTER_KEY_FILE=/ruta/absoluta/a/deploy/secrets/master.key
# SECRETS_LOCAL_MASTER_KEY=
# OpenBao (si SECRETS_PROVIDERS incluye openbao, p. ej. openbao,local: las claves nuevas van al
# primero que admite escritura). Autenticación por AppRole, nunca con un token root.
# En desarrollo: pnpm openbao:bootstrap (crea la política, el rol y el fichero del secret_id).
# Con una CA propia en https, NODE_EXTRA_CA_CERTS=/ruta/ca.pem.
# OPENBAO_ADDR=http://127.0.0.1:8200
# OPENBAO_ROLE_ID=
# OPENBAO_SECRET_ID_FILE=/ruta/absoluta/a/deploy/secrets/openbao-secret-id
# OPENBAO_SECRET_ID=
# OPENBAO_KV_MOUNT=secret
# OPENBAO_KV_PREFIX=infraward
# OPENBAO_APPROLE_MOUNT=approle
# OPENBAO_TIMEOUT_MS=5000
# CA SSH (certificados de vida corta; DESIGN §6): montaje del motor SSH y rol de firma.
# OPENBAO_SSH_MOUNT=infraward-ssh
# OPENBAO_SSH_ROLE=inventory
# Vida de la caché de secretos en memoria, en segundos (0 = sin caché, máx. 300).
SECRETS_CACHE_TTL=30
# Caja fuerte de credenciales (DESIGN §19): el worker NO lleva VAULT_* a propósito. Ni su clave
# local ni su AppRole de OpenBao: así no puede leer nunca la caja fuerte. No las copies aquí.

# Ficheros temporales con secretos (claves SSH): debe ser tmpfs. Por defecto /dev/shm si existe.
# WORKER_TMP_DIR=
# Tiempo máximo de conexión SSH y de ssh-keyscan, en segundos.
SSH_CONNECT_TIMEOUT=15
# Modo CA: vida de los certificados SSH (60-1800 s) y margen con el que se firma otro antes de
# abrir una conexión. Cada job autentica una vez (ControlMaster) y el certificado solo se
# comprueba al autenticar.
SSH_CERT_TTL=300
SSH_CERT_RENEW_MARGIN=60

# Recolección con Ansible (necesita ansible-core en el worker y python3 en los servidores).
ANSIBLE_PLAYBOOK_BIN=ansible-playbook
# Directorio ansible/ con los playbooks; por defecto, el del monorepo.
# ANSIBLE_DIR=
# Tiempo máximo de una recolección, en segundos.
COLLECT_TIMEOUT=600

# Escaneo de imágenes con Trivy (necesita `trivy` en el worker).
TRIVY_BIN=trivy
# Caché de las bases de datos de Trivy (~3 GB); por defecto ~/.cache/infraward/trivy. Con varias
# réplicas, la MISMA para todas (un volumen compartido): se descarga una vez, bajo un lock en Redis.
# TRIVY_CACHE_DIR=
# Horas tras las que se vuelven a descargar las bases de datos.
TRIVY_DB_MAX_AGE=12
# Límites por imagen: si se superan, la imagen queda «no escaneada» con el motivo (el job no falla).
TRIVY_SCAN_TIMEOUT=900
TRIVY_MAX_IMAGE_SIZE=4294967296
# Directorio de trabajo (en disco, no tmpfs); por defecto <tmp>/infraward-scan. Cada réplica usa
# <dir>/<nombre>/ y lo vacía al terminar cada escaneo (y al arrancar, lo que quedara).
# WORKER_SCAN_DIR=

# SBOMs (CycloneDX) de imágenes, servidores y CT.
# Horas entre re-evaluaciones de los SBOMs guardados con `trivy sbom`, sin conectarse a las máquinas (0 = desactivada).
SBOM_REEVALUATE_INTERVAL=24
# Bytes máximos de las BDs de paquetes (dpkg/apk/rpm) que se copian de un servidor o CT.
HOST_SBOM_MAX_SIZE=268435456

# Gráficos de evolución del panel (DESIGN §15): una muestra al día (global y por proyecto).
# Horas entre muestras (0 = nunca), días de las diarias (después, una por semana) y de las
# semanales (0 = sin límite).
METRICS_SAMPLE_INTERVAL=24
METRICS_DAILY_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=0

# Priorización (DESIGN §9): CISA KEV y EPSS de FIRST, con caché HTTP; si una descarga falla, se conservan los datos anteriores.
# Horas entre descargas (0 = nunca; a mano, desde Vulnerabilidades).
VULN_INTEL_INTERVAL=12
# Vacías = esa fuente desactivada (entorno sin salida a Internet o con un espejo propio).
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
VULN_INTEL_TIMEOUT_MS=120000

# Reconciliación (DESIGN §10): el intervalo de cada nodo raíz va en su política de inventario (Ajustes).
# Segundos entre comprobaciones de qué nodos raíz toca reconciliar (0 = apagada).
RECONCILE_TICK=300
# Descubrimientos completos sin ver un asset desaparecido tras los que pasa a «retirado».
RECONCILE_RETIRE_AFTER=3

# Inventario de dominios (DESIGN §13). El token de cada conector va en el proveedor de secretos.
# API de Cloudflare y bootstrap de RDAP de IANA (cambiarlos solo para pruebas).
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
# Milisegundos por petición a la API del proveedor o a RDAP, y por lectura del certificado en el 443.
DOMAINS_HTTP_TIMEOUT_MS=15000
DOMAINS_TLS_TIMEOUT_MS=5000
# Lecturas del 443 y resoluciones DNS a la vez.
DOMAINS_CONCURRENCY=8
# Servidores DNS propios (ip[:puerto], separados por comas) para los CNAME y el 443; vacío = los del sistema.
# DOMAINS_DNS_SERVERS=

# Alertas fuera de la app (DESIGN §10): los canales (webhook, correo) se crean en Ajustes › Alertas.
# URL de la web para los enlaces de las alertas (sin ella, sin enlaces).
# ALERTS_PUBLIC_URL=https://infraward.example
# Webhooks por http: y a IPs privadas (un ntfy o n8n de casa). Loopback y metadatos, nunca.
ALERTS_WEBHOOK_ALLOW_HTTP=false
ALERTS_WEBHOOK_ALLOW_PRIVATE=false
# Milisegundos por envío: el plazo total de un webhook (hasta sus cabeceras); en el correo, el de cada paso de SMTP.
ALERTS_TIMEOUT_MS=10000
# Envíos a la vez (cola propia `alerts`; 0 = esta réplica no envía alertas).
ALERTS_CONCURRENCY=2
# SMTP para los canales de correo (sin SMTP_HOST no envían). TLS directo (465) o STARTTLS obligatorio.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=alertas@example.com
# Contraseña como referencia al gestor de secretos (nunca en claro), p. ej.:
#   printf '{"password":"…"}' | pnpm --filter @infraward/api secrets:put secret://local/smtp
# SMTP_PASSWORD_REF=secret://local/smtp#password
# SMTP_FROM=InfraWard <alertas@example.com>
