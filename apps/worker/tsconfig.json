{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "removeComments": true,
    "target": "ES2023",
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}
