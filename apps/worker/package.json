{
  "name": "@infraward/worker",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "Worker de InfraWard (NestJS standalone): consume la cola y ejecuta el trabajo pesado",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:gateway": "node dist/main.js gateway",
    "dev:gateway": "if [ -f .env.gateway ]; then exec node --watch-path=dist dist/main.js gateway; else echo 'gateway: sin apps/worker/.env.gateway (cp .env.gateway.example .env.gateway), no se arranca'; fi",
    "gateway:cli": "node dist/gateway/cli.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage --coverage.reporter=lcovonly --coverage.reporter=text-summary",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@infraward/connectors": "workspace:*",
    "@infraward/domain": "workspace:*",
    "@infraward/secrets": "workspace:*",
    "@infraward/shared-types": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.0",
    "source-map-support": "^0.5.21",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
