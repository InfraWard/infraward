{
  "name": "@infraward/secrets",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Gestión de secretos por referencias (secret://proveedor/ruta#campo) y proveedores. Solo backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/openbao": {
      "types": "./dist/openbao/openbao-test-server.d.ts",
      "default": "./dist/openbao/openbao-test-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage --coverage.reporter=lcovonly --coverage.reporter=text-summary",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@infraward/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "testcontainers": "^12.2.0",
    "typeorm": "^1.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
